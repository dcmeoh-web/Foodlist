# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 .gitignore 에 들어 있다)
# 비워 두면 저장되지 않는 데모 모드로 열린다. session pooler(Postgres 연결 문자열)는 쓰지 않는다.
# Supabase 대시보드 > Project Settings > API 에서 복사한다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# service_role 키는 VITE_ 를 붙이지 않는다. (붙이면 브라우저에 노출된다)
SUPABASE_SERVICE_ROLE_KEY=
